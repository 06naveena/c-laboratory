using System;
class Program
{
    static void Main()
    {
        int[][] arr =
        {
            new int[] {10,20,30,40},
            new int[] { 5,15},
            new int[] { 2,4,6 },
            new int[] {100,200,300,400,500}
        };
        for (int i = 0; i < arr.Length; i++)
        {
            int sum = 0;
            for(int j = 0; j < arr[i].Length; j++)
            {
                sum += arr[i][j];
            }
            Console.WriteLine("sum of row" + (i+1) + "=" + sum);
        }
    }
}
Output:
sum of row1=100
sum of row2=20
sum of row3=12
sum of row4=1500
